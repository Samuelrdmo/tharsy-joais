# Apenas a URL e a chave PÚBLICA do projeto. Nunca use service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Formato internacional: 55 + DDD + número, somente dígitos.
# Vazio = pedido demonstrativo; não abre conversa com número inventado.
VITE_WHATSAPP_NUMBER=
# Link completo do perfil, ex.: https://instagram.com/tharsy. Vazio = botão oculto.
VITE_INSTAGRAM_URL=
